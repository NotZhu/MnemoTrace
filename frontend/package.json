{
  "name": "mnemotrace-console",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "description": "MnemoTrace Memory Console — production-grade web UI for managing your long-term memory.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test",
    "test:login-graph": "node --test tests/loginMemoryGraphData.test.cjs",
    "test:graph": "node --test tests/quartzGraph.test.cjs tests/quartzViewport.test.cjs",
    "test:demo-auth": "node --test tests/demoAuthMigration.test.cjs tests/apiKeyValidation.test.cjs tests/loginGuidance.test.cjs",
    "test:theme": "node --test tests/theme.test.cjs tests/themeReveal.test.cjs",
    "test:security": "node --test tests/themeBootstrap.test.cjs tests/theme.test.cjs tests/codexSetupCommand.test.cjs tests/demoAuthMigration.test.cjs",
    "test:preferences": "node --test tests/preferences.test.cjs",
    "test:query-isolation": "node --test tests/queryIsolation.test.cjs tests/searchQueries.test.cjs tests/memoryScope.test.cjs tests/apiKeyValidation.test.cjs tests/sessionLifecycle.test.cjs tests/privacySession.test.cjs tests/preferences.test.cjs tests/consoleErrors.test.cjs tests/factsFilters.test.cjs",
    "test:search": "node --test tests/searchQueries.test.cjs tests/graphSearch.test.cjs tests/conversationSearch.test.cjs tests/sessionPicker.test.cjs tests/factsFilters.test.cjs tests/filterSelect.test.cjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@tanstack/react-query": "^5.59.16",
    "@tweenjs/tween.js": "25.0.0",
    "d3": "7.9.0",
    "lucide-react": "^0.454.0",
    "pixi.js": "8.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/d3": "7.4.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.21.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^7.0.2",
    "vite": "^5.4.10"
  }
}
