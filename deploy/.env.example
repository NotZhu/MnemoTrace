# 复制为 deploy/.env 后，至少替换下面的强密钥。不要提交 deploy/.env。
# 同一租户可配置多个密钥用于无停机轮换：tenant:key-new,tenant:key-old
MNEMOTRACE_API_KEYS=release-user:replace-with-at-least-32-random-characters
MNEMOTRACE_PORT=8000
MNEMOTRACE_MAX_REQUEST_BYTES=2097152
MNEMOTRACE_MAX_HOT_USERS=64
MNEMOTRACE_MAX_HOT_FACTS=10000
MNEMOTRACE_EMBEDDER=hashing

# 自动事实抽取需要配置模型及其凭据；为空时仅可使用不依赖抽取的操作。
MNEMOTRACE_LLM=
MNEMOTRACE_ANSWERER=
# Optional: allow callers to select processing=buffered; remember stays immediate by default.
MNEMOTRACE_BUFFERED_EXTRACTION=0
