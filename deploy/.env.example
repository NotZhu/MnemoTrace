# 复制为 deploy/.env 后，填写容器可连接的 Postgres 运行角色连接串。不要提交 deploy/.env。
MNEMOTRACE_DATABASE_URL=postgresql://app_runtime:REPLACE_ME@db.example.invalid:5432/mnemotrace
MNEMOTRACE_DB_ROLE_PREFIX=mnemotrace
MNEMOTRACE_PORT=8000
MNEMOTRACE_MAX_REQUEST_BYTES=2097152
MNEMOTRACE_EMBEDDER=hashing

# 自动事实抽取需要配置模型及其凭据；为空时仅可使用不依赖抽取的操作。
MNEMOTRACE_LLM=
MNEMOTRACE_ANSWERER=
