# 复制为 deploy/.env，为五个登录账号分别生成密码。不要提交 deploy/.env。
# URL 中的密码需百分号编码。引导 DSN 与 POSTGRES_PASSWORD 使用同一密码。
MNEMOTRACE_POSTGRES_PASSWORD=
# 格式示例 postgresql://app_runtime:ENCODED_PASSWORD@db:5432/mnemotrace
MNEMOTRACE_BOOTSTRAP_DATABASE_URL=
MNEMOTRACE_DATABASE_URL=
MNEMOTRACE_MIGRATION_DATABASE_URL=
MNEMOTRACE_ADMIN_DATABASE_URL=
MNEMOTRACE_DISCOVERY_DATABASE_URL=
MNEMOTRACE_DB_ROLE_PREFIX=mnemotrace
MNEMOTRACE_PORT=8000
MNEMOTRACE_MAX_REQUEST_BYTES=2097152
MNEMOTRACE_EMBEDDER=hashing

# 自动事实抽取需要配置模型及其凭据；为空时仅可使用不依赖抽取的操作。
MNEMOTRACE_LLM=
MNEMOTRACE_ANSWERER=
